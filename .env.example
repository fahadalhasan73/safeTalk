# Copy to .env. NEVER commit real secrets.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST.mongodb.net/safetalk_dev
JWT_SECRET=replace-with-strong-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
# Optional: used by admin seed command. Set strong unique passwords.
ADMIN_ONE_ID=admin-one
ADMIN_ONE_PASSWORD=
ADMIN_TWO_ID=admin-two
ADMIN_TWO_PASSWORD=
# For localhost; configure same variables in Vercel project settings
PORT=5000
NODE_ENV=development
# Required for Vercel Blob (optional uploads; without it uploads are disabled)
BLOB_READ_WRITE_TOKEN=
# Optional for Vercel Cron. Endpoint checks Authorization: Bearer CRON_SECRET
CRON_SECRET=
